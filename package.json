{
  "name": "stygiomedusa-companion-tool",
  "version": "0.11.0",
  "private": true,
  "description": "Stygiomedusa 夥伴包的製作工具包: 範本產生, 驗證, 打包與預覽",
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "template": "node tools/template.mjs",
    "validate": "uv run tools/companion.py validate",
    "pack": "uv run tools/companion.py pack",
    "selftest": "uv run tools/companion.py selftest",
    "preview": "node tools/preview.mjs",
    "setup:browser": "playwright install chromium"
  },
  "devDependencies": {
    "@lottiefiles/dotlottie-web": "0.81.0",
    "playwright": "1.64.1"
  }
}
